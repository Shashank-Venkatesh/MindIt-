# Copy this file to .env and fill in real values.
# These match the same Supabase project as server/.env.
# The anon key is safe for the browser — Row Level Security (if enabled)
# and the backend's JWT check are what actually protect data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
