# Copy this file to .env and fill in real values. Never commit the real .env.

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# Project Settings -> Database -> Connection string (URI), with your DB password filled in
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

PORT=4000
